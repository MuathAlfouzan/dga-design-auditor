{
  "name": "dga-design-auditor",
  "version": "0.1.0",
  "description": "Score any website or Figma design against the DGA Platforms Code design system, out of 100, with a per-check breakdown. Runs entirely in the page.",
  "type": "module",
  "license": "MIT",
  "main": "src/score.js",
  "exports": {
    ".": "./src/score.js",
    "./probe": "./src/probe.js",
    "./render": "./src/render.js",
    "./bundle": "./dist/dga-rate.js",
    "./data/*": "./data/*",
    "./updates": "./src/updates.js"
  },
  "files": [
    "src",
    "dist",
    "data",
    "docs",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/selftest.mjs && node test/parity.mjs && node test/integrity.test.mjs && node test/probe.test.mjs && node test/updates.test.mjs && node test/parts.test.mjs && node test/checks.test.mjs && node test/locators.test.mjs && node test/criteria.test.mjs && node test/a11y.test.mjs && node test/axe.test.mjs",
    "test:score": "node test/selftest.mjs",
    "test:parity": "node test/parity.mjs",
    "test:integrity": "node test/integrity.test.mjs",
    "test:probe": "node test/probe.test.mjs",
    "test:updates": "node test/updates.test.mjs",
    "test:parts": "node test/parts.test.mjs",
    "test:checks": "node test/checks.test.mjs",
    "test:locators": "node test/locators.test.mjs",
    "test:criteria": "node test/criteria.test.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "test:a11y": "node test/a11y.test.mjs",
    "test:axe": "node test/axe.test.mjs"
  },
  "keywords": [
    "dga",
    "sdga",
    "platforms-code",
    "design-system",
    "compliance",
    "accessibility",
    "wcag",
    "rtl",
    "arabic",
    "saudi",
    "design-tokens",
    "audit"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "axe-core": "^4.13.0"
  }
}
